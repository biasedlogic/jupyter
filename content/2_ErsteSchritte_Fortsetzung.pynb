      "source": "age = int(input(\"Wie alt bist Du? \"))\nif age == 18:\n    print(\"gerade volljährig!\")\n    print(\"Glückwunsch!\")\nelif age > 18:\n    print(\"Volljährig\")\nelse:\n    print(\"Kind\")\nprint(\"Ende.\")",
